---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frames from '../components/Frames.astro';
import ExtLink from '../components/ExtLink.astro';
import CodeBackdrop from '../components/CodeBackdrop.astro';
import SectionHead from '../components/SectionHead.astro';
import Ticker from '../components/Ticker.astro';
import ContactForm from '../components/ContactForm.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const experience = [
  {
    when: '2025-02 / NOW',
    role: 'Front-end Developer',
    org: 'Empowered Futures',
    points: [
      'Work with designers to improve a web app UI in React.',
      'Integrated Docker, Prisma and GraphQL for scalable development and database management.',
      'Ship quality pull requests, following senior feedback and agile practice.',
    ],
  },
  {
    when: '2024-11 / NOW',
    role: 'Full-stack Developer',
    org: 'New Idea Machine',
    points: [
      'Built and maintain a contractor information database with React and Firebase.',
      'Created reusable components and app-wide state with React Context.',
      'Iterate quickly with clients, keeping communication open and responsive.',
    ],
  },
  {
    when: '2024-09 / 2025-04',
    role: 'Front-end Developer',
    org: 'DIVU Canada',
    points: [
      'Kept UX/UI performance scores high on Lighthouse.',
      'Worked in a Git-driven team with fast sprints and code reviews.',
    ],
  },
  {
    when: '2024-08 / 2025-01',
    role: 'Web Developer',
    org: 'Inclucity Calgary',
    points: [
      'Redesigned and built the organization’s website, improving accessibility and responsiveness.',
      'Used agile workflows and stakeholder input to ship a compliant, user-friendly site.',
    ],
  },
];

const skills: [string, string][] = [
  ['Languages', 'TypeScript, JavaScript, Python, Java, C#, HTML, CSS (learning Go)'],
  ['Frontend', 'React, Next.js, Tailwind CSS, three.js / react-three-fiber'],
  ['Backend', 'Node.js, Express, GraphQL, Prisma, Drizzle'],
  ['Data', 'PostgreSQL, MySQL, MongoDB, Firebase, Supabase'],
  ['Cloud & DevOps', 'Docker, Git, GitHub, Azure DevOps, Vercel, AWS'],
  ['Tools', 'Jest, Figma, VS Code'],
];
---
<Base>
  <!-- HERO (dark) -->
  <section class="section on-dark hero">
    <CodeBackdrop />
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">&gt; hello, world<span class="cursor" aria-hidden="true">_</span></p>
        <h1>Daniel<br />Nguyen</h1>
        <p class="pitch">
          Software engineer in Calgary building web apps and AI-powered tools,
          from the 3D interface down to the database.
        </p>
        <p class="actions">
          <a class="btn" href="#work">View work</a>
          <a class="btn ghost" href="#contact">Get in touch</a>
        </p>
      </div>
      <Frames />
    </div>
  </section>

  <Ticker />

  <!-- 01 WORK (light) -->
  <section class="section on-light" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <SectionHead n={1} total={4} title="Selected work" id="work-h" />
      <ul class="rows">
        {projects.map((p, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a href={`/projects/${p.id}/`}>
              <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="main">
                <strong>{p.data.title}</strong>
                <span class="sum">{p.data.summary}</span>
                <span class="meta">
                  <span class="yr">{p.data.year}</span>
                  <span class="stack">{p.data.stack.join(' / ')}</span>
                </span>
              </span>
              <svg class="go" viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true" focusable="false">
                <path d="M6 18 18 6M8 6h10v10" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 02 EXPERIENCE (dark) -->
  <section class="section on-dark" id="experience" aria-labelledby="exp-h">
    <div class="wrap">
      <SectionHead n={2} total={4} title="Experience" id="exp-h" />
      <ul class="jobs">
        {experience.map((j, i) => (
          <li class="reveal" style={`--i:${i % 2}`}>
            <span class="when">{j.when}</span>
            <div>
              <h3>{j.role}</h3>
              <p class="org">{j.org}, Calgary, AB</p>
              <ul class="pts">
                {j.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 ABOUT + SKILLS (light) -->
  <section class="section on-light" id="about" aria-labelledby="about-h">
    <div class="wrap">
      <SectionHead n={3} total={4} title="About" id="about-h" />
      <div class="about-text reveal">
        <p>
          I&rsquo;m a software engineer based in Calgary. Since 2024 I&rsquo;ve
          worked across four teams on React, Next.js, Firebase, GraphQL and Prisma,
          shipping features through code review, sprints and CI.
        </p>
        <p>
          Outside client work I build my own products. Connecton, a 3D city for keeping in
          touch with the people who matter, is the one I&rsquo;m proudest of: it taught me
          to put the rules that matter (XP, limits, ownership) in the database, not the browser.
        </p>
        <p>Right now I&rsquo;m learning Go, and looking for my next engineering role.</p>
        <p class="edu">Software Development Diploma, SAIT (2025).</p>
      </div>

      <table class="spec skills reveal" aria-label="Skills by area">
        <tbody>
          {skills.map(([k, v]) => (
            <tr><th scope="row">{k}</th><td>{v}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 04 CONTACT (dark) -->
  <section class="section on-dark" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <SectionHead n={4} total={4} title="Contact" id="contact-h" />
      <div class="contact-grid">
        <div>
          <p class="ask reveal">Open to software engineering roles. Send me a message and I will reply by email.</p>
          <p class="actions reveal" style="--i:1">
            <ExtLink class="btn ghost" href="https://github.com/DinhAnh-Nguyen" rel="me">GitHub</ExtLink>
            <ExtLink class="btn ghost" href="https://www.linkedin.com/in/dinhanh-nguyen/" rel="me">LinkedIn</ExtLink>
            <ExtLink class="btn ghost" href="/DanielNguyen_Resume.pdf">Resume (PDF)</ExtLink>
          </p>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(40px, 7vw, 88px); }
  .hero-grid { display: grid; gap: clamp(32px, 6vw, 64px); align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.1fr 1fr; } }
  .eyebrow { color: var(--muted); font-size: 14px; margin-bottom: 16px; }
  h1 { font-size: clamp(2.6rem, 10vw, 6.5rem); letter-spacing: -0.03em; margin-bottom: 28px; }
  .pitch { max-width: 34em; color: var(--muted); }
  .pitch, .ask { font-size: clamp(15px, 2.4vw, 18px); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .rows { border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { display: grid; grid-template-columns: 3ch 1fr auto; gap: 8px clamp(12px, 3vw, 32px); align-items: start;
    padding: clamp(20px, 3vw, 32px) 8px; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .rows a:hover, .rows a:focus-visible { background: var(--fg); color: var(--bg); outline-offset: -2px; }
  .idx { font-size: 14px; padding-top: 0.5em; }
  .rows .main { display: grid; gap: 8px; }
  .rows strong { font-size: clamp(1.6rem, 5vw, 3rem); text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.05; }
  .rows .sum { font-size: 15px; max-width: 46em; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 13px; letter-spacing: 0.04em; opacity: 0.8; margin-top: 6px; }
  .go { width: clamp(32px, 6vw, 64px); height: auto; transition: transform 0.2s ease, color 0.2s; }
  .rows a:hover .go, .rows a:focus-visible .go { transform: translate(8px, -8px); color: var(--accent-lit); }
  .rows .main { transition: transform 0.2s ease; }
  .rows a:hover .main, .rows a:focus-visible .main { transform: translateX(10px); }
  @media (prefers-reduced-motion: reduce) { .go, .rows .main { transition: none; } .rows a:hover .go, .rows a:focus-visible .go, .rows a:hover .main, .rows a:focus-visible .main { transform: none; } }

  .jobs > li { display: grid; gap: 8px 32px; padding: 28px 0; border-top: 1px solid var(--line); }
  .jobs > li:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 800px) { .jobs > li { grid-template-columns: 13em 1fr; } }
  .when { font-size: 13px; letter-spacing: 0.06em; color: var(--mark); }
  .jobs h3 { font-size: clamp(1.1rem, 3vw, 1.5rem); }
  .org { color: var(--muted); font-size: 14px; margin: 4px 0 12px; }
  .pts { display: grid; gap: 6px; font-size: 14px; }
  .pts li { padding-left: 2ch; text-indent: -2ch; }
  .pts li::before { content: '- '; color: var(--mark); }

  .about-text { max-width: 40em; margin-bottom: clamp(40px, 6vw, 72px); }
  .edu { color: var(--muted); font-size: 14px; }
  .skills th { background: var(--ink); color: var(--paper); width: 1%; white-space: nowrap; }

  .ask { max-width: 28em; }
  .contact-grid { display: grid; gap: clamp(32px, 5vw, 56px); align-items: start; }
  @media (min-width: 900px) { .contact-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); } }
</style>
