---
// Shown by GitHub Pages for any address that does not exist.
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Daniel Nguyen" description="This page does not exist." noindex>
  <section class="section on-dark">
    <div class="wrap">
      <h1 class="title"><span class="dec">Page not found</span></h1>
      <p class="msg">That address does not lead anywhere. The work, experience and contact sections are on the home page.</p>
      <p><a class="btn" href="/">Back to the site</a></p>
    </div>
  </section>
</Base>

<style>
  .msg { font-size: clamp(15px, 2.4vw, 18px); margin-bottom: 28px; }
</style>
