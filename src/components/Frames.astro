---
// The rotating "frames" in the hero: blocks of monospace text that swap
// every few seconds with a decode effect. Without JavaScript the first
// frame simply stays on screen.
const frames = [
  {
    text: `@DANIEL NGUYEN
ROLE      FULL-STACK DEVELOPER
FOCUS     WEB + AI
BASE      CALGARY, AB
EDU       SAIT DIPLOMA, GPA 3.90
STATUS    OPEN TO WORK
MAIL      dinhanhnguyen.work@gmail.com`,
  },
  {
    text: `// webhook check (sketch)
const ok = timingSafeEqual(
  Buffer.from(signature),
  Buffer.from(digest)
);

if (!ok)
  return res.status(401).end();

if (pr.merged) await save(pr);`,
  },
  {
    text: `+----------+---------------------+
| LANG     | TS JS PYTHON JAVA   |
| FRONT    | REACT NEXT TAILWIND |
| BACK     | NODE EXPRESS GQL    |
| DATA     | POSTGRES FIREBASE   |
| 3D       | THREE.JS R3F        |
| OPS      | DOCKER GIT VERCEL   |
| LEARNING | GO                  |
+----------+---------------------+`,
  },
  {
    text: `$ git log --oneline | wc -l
219          # connecton

$ cat TODO.md
[x] ship connecton
[x] ship this site
[ ] learn go
[ ] get hired :)`,
  },
];
const total = String(frames.length).padStart(2, '0');
---
<section class="frames" aria-label="Facts about Daniel" data-frames>
  <p class="sr-only">Full-stack developer in Calgary, open to work. Email dinhanhnguyen.work@gmail.com.</p>
  <div class="bar">
    <span data-counter>FRAME 01/{total}</span>
    <span class="ctl">
      <button type="button" data-toggle aria-pressed="false">PAUSE</button>
      <button type="button" data-next>NEXT -&gt;</button>
    </span>
  </div>
  <div class="stack">
    {frames.map((f, i) => (
      <pre aria-hidden="true" data-frame data-active={i === 0 ? '' : undefined}>{f.text}</pre>
    ))}
  </div>
</section>

<style>
  .frames { border: 1px solid #fff; background: #000; color: #fff; max-width: 100%; }
  .bar { display: flex; justify-content: space-between; gap: 12px; padding: 8px 14px; border-bottom: 1px solid #fff;
    font-size: 12px; letter-spacing: 0.08em; }
  .ctl { display: flex; gap: 14px; }
  .ctl button { all: unset; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .ctl button:hover { background: #fff; color: #000; }
  .ctl button:focus-visible { outline: 2px dashed #fff; outline-offset: 3px; }
  /* All frames share one grid cell, so the box never changes height. */
  .stack { display: grid; padding: 18px 14px; overflow-x: auto; }
  pre { grid-area: 1 / 1; margin: 0; font: inherit; font-size: clamp(11px, 3vw, 14px); line-height: 1.6; white-space: pre; visibility: hidden; }
  pre[data-active] { visibility: visible; }
</style>

<script>
  import { planDecode, frameAt } from '../lib/scramble.js';

  const root = document.querySelector<HTMLElement>('[data-frames]');
  if (root) {
    const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-frame]'));
    const targets = frames.map((f) => f.textContent ?? '');
    const counter = root.querySelector<HTMLElement>('[data-counter]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const HOLD = 3600;
    const DECODE = 650;

    let index = 0;
    let paused = reduced.matches;
    let timer: number | undefined;
    let raf = 0;
    let hovering = false;

    const pad = (n: number) => String(n).padStart(2, '0');

    function show(to: number) {
      cancelAnimationFrame(raf);
      frames.forEach((f, i) => {
        if (i === to) f.setAttribute('data-active', '');
        else f.removeAttribute('data-active');
        f.textContent = targets[i];
      });
      index = to;
      counter.textContent = `FRAME ${pad(to + 1)}/${pad(frames.length)}`;
      if (reduced.matches) return;

      const el = frames[to];
      const plan = planDecode(targets[to], to + 1);
      const start = performance.now();
      let tick = 0;
      const step = (now: number) => {
        const p = Math.min((now - start) / DECODE, 1);
        el.textContent = frameAt(targets[to], plan, p, tick++);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    function schedule() {
      clearTimeout(timer);
      if (paused || hovering || document.hidden) return;
      timer = window.setTimeout(() => {
        show((index + 1) % frames.length);
        schedule();
      }, HOLD);
    }

    function setPaused(value: boolean) {
      paused = value;
      toggle.textContent = paused ? 'PLAY' : 'PAUSE';
      toggle.setAttribute('aria-pressed', String(paused));
      schedule();
    }

    toggle.addEventListener('click', () => setPaused(!paused));
    next.addEventListener('click', () => { show((index + 1) % frames.length); schedule(); });
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovering = true; schedule(); } });
    root.addEventListener('pointerleave', () => { hovering = false; schedule(); });
    reduced.addEventListener('change', () => setPaused(reduced.matches));
    document.addEventListener('visibilitychange', schedule);

    setPaused(paused);
  }
</script>
