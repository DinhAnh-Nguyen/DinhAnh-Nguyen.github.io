---
// A link that opens in a new tab. Tells screen-reader users it does,
// and uses rel="noopener noreferrer" so the new page cannot reach back.
interface Props {
  href: string;
  class?: string;
  rel?: string;
}
const { href, class: className, rel } = Astro.props;
const relValue = [...new Set(['noopener', 'noreferrer', ...(rel?.split(' ') ?? [])])].join(' ');
---
<a href={href} class={className} target="_blank" rel={relValue}><slot /><span class="sr-only"> (opens in a new tab)</span></a>
