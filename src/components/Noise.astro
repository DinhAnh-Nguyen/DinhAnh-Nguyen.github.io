---
// Animated TV-static behind the hero. Drawn on a small canvas and scaled up,
// so it costs almost nothing and stays sharp on any screen.
---
<canvas class="noise" aria-hidden="true" width="320" height="180" data-noise></canvas>

<style>
  .noise {
    position: absolute; inset: 0; z-index: -3; width: 100%; height: 100%;
    image-rendering: pixelated; opacity: 0.13; pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-noise]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const { width, height } = canvas;
    const image = ctx.createImageData(width, height);
    const px = new Uint32Array(image.data.buffer);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const FRAME_MS = 1000 / 12;
    let last = 0;
    let raf = 0;
    let visible = true;

    const draw = () => {
      for (let i = 0; i < px.length; i++) {
        const v = (Math.random() * 256) | 0;
        px[i] = 0xff000000 | (v << 16) | (v << 8) | v;
      }
      ctx.putImageData(image, 0, 0);
    };

    const loop = (t: number) => {
      raf = requestAnimationFrame(loop);
      if (t - last < FRAME_MS) return;
      last = t;
      draw();
    };

    const sync = () => {
      cancelAnimationFrame(raf);
      draw();
      if (!reduced.matches && visible && !document.hidden) raf = requestAnimationFrame(loop);
    };

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(canvas);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    sync();
  }
</script>
