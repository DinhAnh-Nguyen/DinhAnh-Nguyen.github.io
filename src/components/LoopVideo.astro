---
// A silent looping clip. The script starts it; it never plays for visitors who
// prefer reduced motion, or when JavaScript is off (the poster picture is
// shown instead).
interface Props {
  src: string;
  poster: string;
  width: number;
  height: number;
  label: string;
}
const { src, poster, width, height, label } = Astro.props;
---
<div class="loop" data-loop>
  <video src={src} poster={poster} width={width} height={height} muted loop playsinline preload="metadata" disablepictureinpicture aria-label={label}></video>
</div>

<style>
  .loop { background: var(--ink); }
  video { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-loop] video').forEach((v) => { void v.play().catch(() => {}); });
  }
</script>
