---
import { SITE, WEB3FORMS_ACCESS_KEY, FORM_READY } from '../config.js';
---
<!-- One wrapper so the notice and the form are a single item in the contact grid. -->
<div class="cf-wrap">
{!FORM_READY && (
  <p class="setup reveal">The contact form is being set up. Until then, please message me on <a href="https://www.linkedin.com/in/dinhanh-nguyen/" target="_blank" rel="noopener noreferrer me">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>.</p>
)}
<form class="cf reveal" style="--i:1" method="POST" action={FORM_READY ? 'https://api.web3forms.com/submit' : undefined} data-contact data-ready={FORM_READY ? 'true' : 'false'}>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="New message from the portfolio" />
  <input type="hidden" name="from_name" value="Portfolio contact form" />
  <input type="hidden" name="redirect" value={`${SITE}/thanks/`} />
  <!-- Spam trap: people never see or fill this in, simple bots do. -->
  <div class="trap" aria-hidden="true">
    <label>Leave this empty <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="field">
    <label for="cf-name">Name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="cf-name-err" />
    <p class="err" id="cf-name-err" hidden></p>
  </div>

  <div class="field">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="cf-email-err" />
    <p class="err" id="cf-email-err" hidden></p>
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required maxlength="3000" aria-describedby="cf-message-err"></textarea>
    <p class="err" id="cf-message-err" hidden></p>
  </div>

  <p class="note">I only use these details to reply to you. See the <a href="/privacy/">privacy policy</a>.</p>
  <button class="btn" type="submit" data-submit>Send message</button>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>
</div>

<style>
  .setup { max-width: 640px; margin: 0 0 20px; padding: 12px 14px; border: 1px dashed var(--fg); font-size: 14px; }
  .cf { display: grid; gap: 20px; max-width: 640px; }
  .field { display: grid; gap: 8px; }
  label { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  input[type='text'], input[type='email'], textarea {
    width: 100%; font: inherit; font-size: 16px; color: var(--fg); background: color-mix(in srgb, var(--ink) 60%, transparent);
    border: 1px solid var(--fg); border-radius: 0; padding: 12px 14px; line-height: 1.5;
  }
  textarea { resize: vertical; min-height: 9em; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent-lit); outline-offset: 2px; }
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: #ff9c8f; border-width: 2px; }
  .err { margin: 0; color: #ff9c8f; font-size: 14px; }
  .err::before { content: '! '; font-weight: 600; }
  .note { margin: 0; font-size: 13px; color: var(--muted); }
  .btn { justify-self: start; }
  .btn[disabled] { opacity: 0.6; cursor: progress; }
  .status { margin: 0; min-height: 1.6em; font-size: 15px; }
  .status[data-kind='ok'] { color: var(--fg); }
  .status[data-kind='ok']::before { content: '+ '; color: var(--accent-lit); }
  .status[data-kind='error'] { color: #ff9c8f; }
  /* Off-screen, not display:none, so simple bots still see and fill it. */
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    form.noValidate = true; // we show our own messages; without JS the browser's own checks still apply
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fields = ['name', 'email', 'message'] as const;
    const messages: Record<(typeof fields)[number], string> = {
      name: 'Please enter your name.',
      email: 'Please enter a valid email address, like name@example.com.',
      message: 'Please write a message.',
    };

    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;
    const errEl = (n: string) => document.getElementById(`cf-${n}-err`)!;
    const setStatus = (text: string, kind = '') => { status.textContent = text; status.dataset.kind = kind; };

    function validate(): string | null {
      let first: string | null = null;
      for (const n of fields) {
        const el = field(n);
        const ok = el.value.trim() !== '' && (n !== 'email' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim()));
        el.setAttribute('aria-invalid', String(!ok));
        const e = errEl(n);
        e.hidden = ok;
        e.textContent = ok ? '' : messages[n];
        if (!ok && !first) first = n;
      }
      return first;
    }

    for (const n of fields) {
      field(n).addEventListener('input', () => {
        if (field(n).getAttribute('aria-invalid') === 'true') validate();
      });
    }

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const bad = validate();
      if (bad) {
        field(bad).focus();
        setStatus('Please fix the highlighted fields.', 'error');
        return;
      }
      if (form.dataset.ready !== 'true') {
        setStatus('The contact form is not switched on yet. Please try again later.', 'error');
        return;
      }
      submit.disabled = true;
      submit.textContent = 'Sending...';
      setStatus('Sending your message...');
      try {
        const data = Object.fromEntries(new FormData(form));
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || out.success === false) {
          console.error('Contact form failed', res.status, out);
          throw new Error(out.message || 'failed');
        }
        form.reset();
        setStatus('Thanks! Your message was sent. I will reply by email.', 'ok');
      } catch (err) {
        console.error('Contact form error', err);
        setStatus('Sorry, that did not send. Please try again in a moment.', 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send message';
      }
    });
  }
</script>
