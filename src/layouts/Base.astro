---
import '../styles/global.css';
import ExtLink from '../components/ExtLink.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Daniel Nguyen | Software Engineer',
  description = 'Daniel Nguyen is a software engineer in Calgary building web apps and AI-powered tools. Projects, experience and contact.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0e0d" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      var d = document.documentElement;
      d.classList.add('js');
      // If the motion script has not started within 2.5s (blocked or failed), show everything.
      setTimeout(function () { if (!d.hasAttribute('data-motion-ready')) d.classList.add('no-motion'); }, 2500);
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="DN, Daniel Nguyen home">DN<span class="cursor" aria-hidden="true">_</span></a>
        <nav aria-label="Primary">
          <a href="/#work">Work</a>
          <a href="/#experience">Experience</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
          <ExtLink href="/DanielNguyen_Resume.pdf">Resume</ExtLink>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer on-light">
      <div class="wrap block">
        <small class="cell">&copy; 2026 Daniel Nguyen</small>
        <small class="cell">Software engineer / Calgary, AB</small>
        <small class="cell"><a href="/privacy/">Privacy policy</a></small>
      </div>
    </footer>
    <script>import '../scripts/motion.js';</script>
  </body>
</html>
